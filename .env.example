SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-key
TELEGRAM_BOTS_JSON={"government":{"token":"replace-me","chat_id":"@government_notice_channel"},"cafe":{"token":"replace-me","chat_id":"@cafe_event_channel"}}
